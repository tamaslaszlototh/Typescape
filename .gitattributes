* text=auto

# Fixture solutions and golden files must be byte-identical on macOS and Windows.
tests/fixtures/** text eol=lf
*.verified.txt text eol=lf
*.verified.json text eol=lf

# Generated from the Snapshot records (dotnet run build.cs -- schema); LF everywhere, so regenerating it changes nothing.
schema/snapshot.schema.json text eol=lf
