<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- xunit.v3 names its generated entry point's namespace after a hash of the project's full path, so every
         checkout of the fixture would get another type key. Program.cs is that entry point under a fixed name. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <!-- These compile two files from the NuGet cache, whose paths differ per machine. -->
    <XunitRegisterBuiltInRunnerReporters>false</XunitRegisterBuiltInRunnerReporters>
    <XunitRegisterBuiltInResultWriters>false</XunitRegisterBuiltInResultWriters>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Gallery/Gallery.csproj" />
  </ItemGroup>
</Project>
