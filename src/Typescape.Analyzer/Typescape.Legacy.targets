<Project>
  <!-- .NET SDK MSBuild imports WinFX only for Silverlight, so classic WPF projects get no markup compile. The framework
       and version conditions are those of Visual Studio MSBuild's own import in Microsoft.NETFramework.CurrentVersion.targets. -->
  <PropertyGroup>
    <_TypescapeWinFXTargets>$(MSBuildExtensionsPath)/Sdks/Microsoft.NET.Sdk.WindowsDesktop/targets/Microsoft.WinFX.targets</_TypescapeWinFXTargets>
  </PropertyGroup>
  <Import Project="$(_TypescapeWinFXTargets)"
          Condition="'$(UsingMicrosoftNETSdk)' != 'true' and '$(MSBuildRuntimeType)' == 'Core'
                     and ('$(TargetFrameworkIdentifier)' == '' or '$(TargetFrameworkIdentifier)' == '.NETFramework') and '$(TargetRuntime)' == 'Managed'
                     and '$(TargetFrameworkVersion)' != 'v2.0' and '$(TargetCompactFramework)' != 'true'
                     and Exists('$(_TypescapeWinFXTargets)')" />
</Project>
