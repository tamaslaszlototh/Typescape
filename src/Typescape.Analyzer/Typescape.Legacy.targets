<Project>
  <!-- The legacy compatibility kit's WPF part, imported from Typescape.targets.

       The .NET SDK's Microsoft.Common.CurrentVersion.targets imports Microsoft.WinFX.targets only for Silverlight, so a
       classic WPF project loaded by .NET SDK MSBuild (macOS, or Windows without Visual Studio) gets no markup compile:
       no *.g.cs, no InitializeComponent, no x:Name fields. SDK-style projects get WPF from the WindowsDesktop SDK, and
       Visual Studio MSBuild (MSBuildRuntimeType Full) imports WinFX itself, so both are left alone. -->
  <PropertyGroup>
    <_TypescapeWinFXTargets>$(MSBuildExtensionsPath)/Sdks/Microsoft.NET.Sdk.WindowsDesktop/targets/Microsoft.WinFX.targets</_TypescapeWinFXTargets>
  </PropertyGroup>
  <Import Project="$(_TypescapeWinFXTargets)"
          Condition="'$(UsingMicrosoftNETSdk)' != 'true' and '$(MSBuildRuntimeType)' == 'Core' and Exists('$(_TypescapeWinFXTargets)')" />
</Project>
